unsigned long lastAttempt = 0;
const unsigned long UPLOAD_INTERVAL_MS = 2000;

bool cameraStart() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM; config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM; config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM; config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM; config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM; config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM; config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM; config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM; config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;
  config.frame_size = FRAMESIZE_QVGA; // 320x240: conservative initial setting
  config.jpeg_quality = 14;            // lower number = better quality/larger file
  config.fb_count = 1;                  // conserve camera RAM
  config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;
  config.fb_location = CAMERA_FB_IN_PSRAM;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("Camera init failed: 0x%x. Check board, ribbon cable and PSRAM.\n", err);
    return false;
  }
  return true;
}

void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to Wi-Fi");
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(500); Serial.print('.');
  }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("Wi-Fi connected; IP: "); Serial.println(WiFi.localIP());
    // Set clock for TLS certificate validity checks.
    configTime(0, 0, "pool.ntp.org", "time.google.com");
    time_t now = time(nullptr);
    unsigned long waitStart = millis();
    while (now < 1700000000 && millis() - waitStart < 15000) {
      delay(250); now = time(nullptr);
    }
    if (now < 1700000000) Serial.println("Warning: NTP time unavailable; TLS validation may fail.");
  } else Serial.println("Wi-Fi connect timed out; retrying later.");
}

void uploadFrame() {
  if (WiFi.status() != WL_CONNECTED) return;
  WiFiClientSecure tls;
  tls.setCACert(ROOT_CA); // Validates server certificate; do not replace with setInsecure().
  HTTPClient http;
  http.setConnectTimeout(10000);
  http.setTimeout(12000);
  if (!http.begin(tls, SERVER_URL)) {
    Serial.println("HTTPS begin failed; check SERVER_URL."); return;
  }
  http.addHeader("Content-Type", "image/jpeg");
  http.addHeader("X-Camera-Key", CAMERA_API_KEY);

  camera_fb_t* fb = esp_camera_fb_get();
  if (!fb) {
    Serial.println("Camera capture failed."); http.end(); return;
  }
  int code = http.POST(fb->buf, fb->len);
  esp_camera_fb_return(fb); // Always release the frame buffer after POST.
  if (code > 0) {
    Serial.printf("Upload HTTP %d\n", code);
    if (code != HTTP_CODE_OK) Serial.println(http.getString());
  } else {
    Serial.printf("HTTPS upload error: %s\n", http.errorToString(code).c_str());
  }
  http.end();
}

void setup() {
  Serial.begin(115200);
  delay(500);
  if (String(WIFI_SSID).startsWith("REPLACE_") || String(SERVER_URL).indexOf("REPLACE_") >= 0 || String(CAMERA_API_KEY).startsWith("REPLACE_")) {
    Serial.println("Edit Wi-Fi, SERVER_URL, and CAMERA_API_KEY before uploading.");
    while (true) delay(1000);
  }
  if (!psramFound()) Serial.println("PSRAM not detected; camera may fail or have limited memory.");
  if (!cameraStart()) { while (true) delay(3000); }
  connectWiFi();
}

void loop() {
  connectWiFi();
  if (WiFi.status() == WL_CONNECTED && millis() - lastAttempt >= UPLOAD_INTERVAL_MS) {
    lastAttempt = millis();
    uploadFrame();
  }
  delay(50);
}
